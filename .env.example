# API Keys for News Enrichment
# Copy this file to .env and fill in your API keys

# Reddit API (OAuth) - Uses PRAW library
# Get credentials at: https://www.reddit.com/prefs/apps
# Create a "script" type app
REDDIT_CLIENT_ID=your_reddit_client_id
REDDIT_CLIENT_SECRET=your_reddit_client_secret

# The Guardian Open Platform API
# Get your free key at: https://open-platform.theguardian.com/access/
GUARDIAN_API_KEY=your_guardian_api_key_here

# New York Times Article Search API
# Get your free key at: https://developer.nytimes.com/
# Rate limit: 5 requests/minute, 500/day
NYT_API_KEY=your_nyt_api_key_here

# NewsAPI.org (alternative news aggregator)
# Get your free key at: https://newsapi.org/
# Note: Free tier limited to 100 requests/day, articles up to 1 month old
NEWSAPI_KEY=your_newsapi_key_here
